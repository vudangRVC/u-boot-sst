if RZG2L

config R9A07G044L
	bool "Renesas R9A07G044L SoC"
	imply CLK_R9A07G044L
	help
	  Enable support for the Renesas R9A07G044L (RZ/G2L) SoC.

config R9A07Gx
	bool "Renesas SoC RZ Common Boards"

choice
	prompt "Renesas RZ/G2L Family Board selection"
	default TARGET_RZG2L_SMARC_EVK

config TARGET_RZG2L_SMARC_EVK
	bool "Renesas RZ/G2L SMARC EVK"
	imply R9A07G044L
	help
	  Enable support for the RZ/G2L SMARC evaluation board.

config TARGET_RZG2L_SBC
	bool "RZ/G2L SBC board"
	help
	  Support for Renesas RZG2L Raspberry-Pi-like board

config TARGET_RZ_CMN
	bool "RZ common boards"
	help
          Support for Renesas RZG2L SBC, SMARC RZV2L, SMARC RZG2L and RZV2H

endchoice

source "board/renesas/rzg2l/Kconfig"
source "board/renesas/rzg2l-sbc/Kconfig"
source "board/renesas/rz-cmn/Kconfig"

config MULTI_DTB_FIT_UNCOMPRESS_SZ
	default 0x80000 if TARGET_RZG2L_SMARC_EVK

config MULTI_DTB_FIT_USER_DEF_ADDR
	default 0x49000000 if TARGET_RZG2L_SMARC_EVK

endif
