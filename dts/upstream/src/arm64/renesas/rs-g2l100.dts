/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include "r9a07g044.dtsi"
#include "r9a07g044l-u-boot.dtsi"
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <configs/rzg2l-sbc.h>

/ {
	model = "RS-G2L100";
	compatible = "renesas,r9a07g044l", "renesas,rzg2l";

	aliases	{
		spi0 = &sbc;
		serial0 = &scif0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@48000000 {
		device_type = "memory";
		/* Reserve 128MB for secure area */
		reg = <0x0 0x48000000 0x0 0xF8000000>;  /* 4GB - 128MB */
	};
};

&pinctrl {
	eth0_pins: eth0 {
		pinmux = <RZG2L_PINMUX(20, 0, 1)>,//ET0_TXC/TX_CLK
				<RZG2L_PINMUX(20, 1, 1)>, //ET0_TX_CTL/TX_EN
				<RZG2L_PINMUX(20, 2, 1)>, //ET0_TXD0
				<RZG2L_PINMUX(21, 0, 1)>, //ET0_TXD1
				<RZG2L_PINMUX(21, 1, 1)>, //ET0_TXD2
				<RZG2L_PINMUX(22, 0, 1)>, //ET0_TXD3
				<RZG2L_PINMUX(22, 1, 1)>, //ET0_TX_ERR
				<RZG2L_PINMUX(23, 0, 1)>, //ET0_TX_COL
				<RZG2L_PINMUX(23, 1, 1)>, //ET0_TX_CRS
				<RZG2L_PINMUX(24, 0, 1)>, //ET0_RXC/RX_CLK
				<RZG2L_PINMUX(24, 1, 1)>, //ET0_RX_CTL/RX_DV
				<RZG2L_PINMUX(25, 0, 1)>, //ET0_RXD0
				<RZG2L_PINMUX(25, 1, 1)>, //ET0_RXD1
				<RZG2L_PINMUX(26, 0, 1)>, //ET0_RXD2
				<RZG2L_PINMUX(26, 1, 1)>, //ET0_RXD3
				<RZG2L_PINMUX(27, 0, 1)>, //ET0_RX_ERR
				<RZG2L_PINMUX(27, 1, 1)>, //ET0_MDC
				<RZG2L_PINMUX(28, 0, 1)>, //ET0_MDIO
				<RZG2L_PINMUX(28, 1, 1)>; //ET0_LINKSTA
	};

	eth1_pins: eth1 {
		pinmux = <RZG2L_PINMUX(29, 0, 1)>, //ET1_TXC/TX_CLK
				<RZG2L_PINMUX(29, 1, 1)>, //ET1_TX_CTL/TX_EN
				<RZG2L_PINMUX(30, 0, 1)>, //ET1_TXD0
				<RZG2L_PINMUX(30, 1, 1)>, //ET1_TXD1
				<RZG2L_PINMUX(31, 0, 1)>, //ET1_TXD2
				<RZG2L_PINMUX(31, 1, 1)>, //ET1_TXD3
				<RZG2L_PINMUX(32, 0, 1)>, //ET1_TX_ERR
				<RZG2L_PINMUX(32, 1, 1)>, //ET1_TX_COL
				<RZG2L_PINMUX(33, 0, 1)>, //ET1_TX_CRS
				<RZG2L_PINMUX(33, 1, 1)>, //ET1_RXC/RX_CLK
				<RZG2L_PINMUX(34, 0, 1)>, //ET1_RX_CTL/RX_DV
				<RZG2L_PINMUX(34, 1, 1)>, //ET1_RXD0
				<RZG2L_PINMUX(35, 0, 1)>, //ET1_RXD1
				<RZG2L_PINMUX(35, 1, 1)>, //ET1_RXD2
				<RZG2L_PINMUX(36, 0, 1)>, //ET1_RXD3
				<RZG2L_PINMUX(36, 1, 1)>, //ET1_RX_ERR
				<RZG2L_PINMUX(37, 0, 1)>, //ET1_MDC
				<RZG2L_PINMUX(37, 1, 1)>, //ET1_MDIO
				<RZG2L_PINMUX(37, 2, 1)>; //ET1_LINKSTA
	};
};

&extal_clk {
	clock-frequency = <24000000>;
};

&eth0 {
	pinctrl-names = "default";
	pinctrl-0 = <&eth0_pins>;
	alt-mdio-base = <0x11c20000>;
	status = "okay";

	phy-handle = <&phy0>;
	phy-mode = "rgmii";
	phy-index = <0>;
	phy0: ethernet-phy@4 {
		reg = <4>;
	};
};

&eth1 {
	pinctrl-names = "default";
	pinctrl-0 = <&eth1_pins>;
	alt-mdio-base = <0x11c30000>;
	status = "okay";

	phy-handle = <&phy1>;
	phy-mode = "rgmii";
	phy-index = <1>;
	phy1: ethernet-phy@7 {
		reg = <7>;
	};
};

&i2c0 {
	status = "okay";
};

&sbc {
	status = "okay";
	compatible = "renesas,rpc-r8a77995";
	num-cs = <2>;
	#address-cells = <1>;
	#size-cells = <0>;
	spi-max-frequency = <50000000>;
	bank-width = <2>;

	flash0: spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
		reg = <0>;
		status = "okay";
	};
};

&scif0 {
	status = "okay";
	clock = <100000000>;
};

&sdhi0 {
	/* pinctrl placeholder
	 * If this channel is used for interfacing with a SD card, a power enable
	 * pin (SD0_PWR_EN) must be defined.
	 * The SD0_PWR_EN pin is associated with P4_1.
	 * A HIGH signal on SD0_PWR_EN will enable supply voltage for SD card.
	*/
	bus-width = <4>;
	status = "okay";
};

&sdhi1 {
	/* pinctrl placeholder
	 * A power enable pin (SD1_PWR_EN) must be defined to interface with a
	 * SD card.
	 * The SD1_PWR_EN pin is associated with P39_2.
	 * A HIGH signal on SD1_PWR_EN will enable supply voltage for SD card.
	*/
	bus-width = <4>;
	status = "okay";
};
